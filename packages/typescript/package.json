{
  "name": "ngtaxkit",
  "version": "0.1.0",
  "description": "Nigerian tax compliance SDK — VAT, PAYE, WHT, Pension, Payroll, Invoicing. NTA 2025 compliant.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Abraham Tanta <sir.tanta@gmail.com> (https://github.com/mr-tanta)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-tanta/ngtaxkit.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/mr-tanta/ngtaxkit/issues"
  },
  "homepage": "https://ngtaxkit.dev",
  "keywords": [
    "nigeria",
    "tax",
    "vat",
    "paye",
    "wht",
    "payroll",
    "pension",
    "invoice",
    "compliance",
    "nta-2025",
    "fintech"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "optionalDependencies": {
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "@ngtaxkit/core": "*",
    "@types/pdfkit": "^0.17.5",
    "fast-check": "^4.6.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0",
    "vite": "8.0.16",
    "vitest": "^4.1.8"
  }
}
