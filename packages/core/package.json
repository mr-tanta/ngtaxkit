{
  "name": "@ngtaxkit/core",
  "version": "0.0.1",
  "private": true,
  "description": "Core calculation engine — TypeScript source of truth for all Nigerian tax calculations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --sourcemap --clean --target es2022",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "fast-check": "^4.6.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0",
    "vite": "8.0.16",
    "vitest": "^4.1.8"
  }
}
